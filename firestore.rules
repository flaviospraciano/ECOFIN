rules_version = '2';
// ECOFIN · regras de segurança do Firestore
// 1) Troque SEU_EMAIL pelo e-mail do administrador principal (o mesmo de adminEmails em config.js).
// 2) No console do Firebase: Firestore Database > Regras > cole este arquivo > Publicar.
service cloud.firestore {
  match /databases/{database}/documents {

    function signed() { return request.auth != null; }
    function hasProfile() { return exists(/databases/$(database)/documents/users/$(request.auth.uid)); }
    function me() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function adminMails() { return ['SEU_EMAIL@ufc.br']; }
    function isAdmin() { return signed() && (request.auth.token.email in adminMails() || (hasProfile() && me().papel == 'admin')); }
    function isStaff() { return isAdmin() || (signed() && hasProfile() && me().papel in ['professor', 'monitor']); }
    function isProf() { return signed() && hasProfile() && me().papel == 'professor'; }

    // Usuários: cada um lê e edita o próprio perfil, sem mexer no nível de acesso.
    match /users/{uid} {
      allow read: if signed() && (resource == null || resource.data.uid == request.auth.uid || isAdmin());
      allow create: if signed() && request.auth.uid == uid && request.resource.data.uid == uid && request.resource.data.papel == 'aluno';
      allow update: if signed() && (isAdmin() || (request.auth.uid == uid &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['papel', 'profNome', 'uid', 'email'])));
      allow delete: if isAdmin();
    }

    // Calendário: oficiais (staff cria) e pessoais (só do dono).
    match /eventos/{id} {
      allow read: if signed() && (resource.data.escopo == 'oficial' || resource.data.uid == request.auth.uid);
      allow create: if signed() && ((request.resource.data.escopo != 'oficial' && request.resource.data.uid == request.auth.uid)
        || (request.resource.data.escopo == 'oficial' && isStaff()));
      allow update, delete: if signed() && ((resource.data.escopo != 'oficial' && resource.data.uid == request.auth.uid)
        || (resource.data.escopo == 'oficial' && isStaff()));
    }

    // Conteúdo geral: todos leem; só staff altera (config e grade completa: admin pela interface).
    match /disciplinas/{id} { allow read: if signed(); allow write: if isStaff(); }
    match /professores/{id} { allow read: if signed(); allow write: if isStaff(); }
    match /contatos/{id}    { allow read: if signed(); allow write: if isStaff(); }
    match /config/{id}      { allow read: if signed(); allow write: if isAdmin(); }

    // Materiais e questões: todos veem os aprovados; qualquer aluno sugere (fica pendente) e staff aprova.
    match /materiais/{id} {
      allow read: if signed() && (resource.data.status == 'aprovado' || resource.data.autor == request.auth.uid || isStaff());
      allow create: if signed() && request.resource.data.autor == request.auth.uid && (request.resource.data.status == 'pendente' || isStaff());
      allow update: if signed() && (isStaff() || (resource.data.autor == request.auth.uid && resource.data.status == 'pendente' && request.resource.data.status == 'pendente'));
      allow delete: if signed() && (isStaff() || (resource.data.autor == request.auth.uid && resource.data.status == 'pendente'));
    }
    match /questoes/{id} {
      allow read: if signed() && (resource.data.status == 'aprovado' || resource.data.autor == request.auth.uid || isStaff());
      allow create: if signed() && request.resource.data.autor == request.auth.uid && (request.resource.data.status == 'pendente' || isStaff());
      allow update: if signed() && (isStaff() || (resource.data.autor == request.auth.uid && resource.data.status == 'pendente' && request.resource.data.status == 'pendente'));
      allow delete: if signed() && (isStaff() || (resource.data.autor == request.auth.uid && resource.data.status == 'pendente'));
    }

    // Voz do aluno: ideias passam por revisão do administrador; anônimas não guardam o autor.
    match /ideias/{id} {
      allow read: if signed() && (isAdmin() || resource.data.autor == request.auth.uid || (resource.data.status == 'aprovada' && isProf()));
      allow create: if signed() && request.resource.data.status == 'pendente' && (request.resource.data.autor == request.auth.uid || request.resource.data.autor == '');
      allow update, delete: if isAdmin();
    }

    // Pesquisa mensal: uma resposta por aluno por mês.
    match /pesquisas/{id} {
      allow read: if signed() && (isAdmin() || resource.data.uid == request.auth.uid);
      allow create, update: if signed() && request.resource.data.uid == request.auth.uid && id == request.auth.uid + '_' + request.resource.data.mes;
    }
  }
}
